    {
      "id": "home.climate.target-temperature",
      "description": "set_temperature on a climate entity; value in degrees Celsius. Thermostats: climate.hvac (woonkamer).",
      "risk": "safe-control",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "entityId": { "type": "string", "maxLength": 128 }, "value": { "type": "number" } },
        "required": ["entityId", "value"],
        "additionalProperties": false
      }
    },
    {
      "id": "home.lock.lock",
      "description": "lock on a lock entity. Locks: lock.front_door (voordeur).",
      "risk": "external-effect",
      "requiresConfirmation": true,
      "confirmationPhrase": "confirm home action",
      "inputSchema": {
        "type": "object",
        "properties": { "entityId": { "type": "string", "maxLength": 128 } },
        "required": ["entityId"],
        "additionalProperties": false
      }
    }
