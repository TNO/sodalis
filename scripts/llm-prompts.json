{
  "description": "Fixed Dutch prompt set for scripts/llm-compare.ts (task 0037). Every prompt is sent with the same available-action list, so chat prompts also measure spurious actions. An expected argument value of null accepts any value of the schema type; other values must match exactly (strings case-insensitively).",
  "actions": [
    {
      "id": "mail.list-messages",
      "description": "List the most recent messages in the deterministic mock Mail app.",
      "risk": "read",
      "requiresConfirmation": false,
      "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
    },
    {
      "id": "mail.search-messages",
      "description": "Search mock Mail by message text, sender, or subject.",
      "risk": "read",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "query": { "type": "string", "description": "Text to search for.", "maxLength": 200 } },
        "required": ["query"],
        "additionalProperties": false
      }
    },
    {
      "id": "mail.open-message",
      "description": "Open a mock Mail message by its semantic message ID. Visible messages: msg-001 (Anna, Vergadering dinsdag), msg-002 (Bakkerij, Uw bestelling), msg-003 (Huisarts, Afspraak).",
      "risk": "navigate",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "messageId": { "type": "string", "description": "Semantic message ID.", "maxLength": 128 } },
        "required": ["messageId"],
        "additionalProperties": false
      }
    },
    {
      "id": "mail.create-draft",
      "description": "Create a local mock Mail draft without sending it.",
      "risk": "draft",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": { "type": "string", "description": "Recipient address.", "maxLength": 200 },
          "subject": { "type": "string", "description": "Draft subject.", "maxLength": 300 },
          "body": { "type": "string", "description": "Draft message body.", "maxLength": 8000 }
        },
        "required": ["to", "subject", "body"],
        "additionalProperties": false
      }
    },
    {
      "id": "mail.send",
      "description": "Send a message through the mock Mail app.",
      "risk": "external-effect",
      "requiresConfirmation": true,
      "confirmationPhrase": "confirm send",
      "inputSchema": {
        "type": "object",
        "properties": {
          "to": { "type": "string", "description": "Recipient address.", "maxLength": 200 },
          "subject": { "type": "string", "description": "Message subject.", "maxLength": 300 },
          "body": { "type": "string", "description": "Message body.", "maxLength": 8000 }
        },
        "required": ["to", "subject", "body"],
        "additionalProperties": false
      }
    },
    {
      "id": "desktop.open-app",
      "description": "Open a trusted built-in desktop application by its app ID. Apps: calculator (Rekenmachine), notes (Notities), calendar (Agenda), mail (Mail).",
      "risk": "navigate",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "appId": { "type": "string", "description": "Trusted built-in app ID.", "maxLength": 128 } },
        "required": ["appId"],
        "additionalProperties": false
      }
    },
    {
      "id": "home.light.turn-on",
      "description": "turn_on on a light entity. Lights: light.bed_light (slaapkamer), light.kitchen_lights (keuken).",
      "risk": "safe-control",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "entityId": { "type": "string", "maxLength": 128 } },
        "required": ["entityId"],
        "additionalProperties": false
      }
    },
    {
      "id": "home.fan.speed",
      "description": "set_percentage on a fan entity; value is a percentage 0-100. Fans: fan.living_room_fan (woonkamer).",
      "risk": "safe-control",
      "requiresConfirmation": false,
      "inputSchema": {
        "type": "object",
        "properties": { "entityId": { "type": "string", "maxLength": 128 }, "value": { "type": "number" } },
        "required": ["entityId", "value"],
        "additionalProperties": false
      }
