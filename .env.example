# Copy to .env (ignored). All provider selections live here.
SODALIS_PORT=4176
# Compose pulls the Parakeet TDT image from ghcr.io/tno at this tag
# (main, sha-<short>, or a release such as 1.2.3). Set SODALIS_LOCAL_IMAGES=true
# to build it from services/ instead, e.g. when changing its Dockerfile.
SODALIS_IMAGE_TAG=main
SODALIS_LOCAL_IMAGES=false
STT_PROVIDER=parakeet-tdt
# Default: original NVIDIA Parakeet TDT v3, not Parakeet Redux. Requires
# more than a 2 GB Podman VM; see docs/development-stack.md.
# Other local choices: whisper-cpp (needs models/whisper/ggml-small.bin),
# whistle (Cactus Whistle/Needle). Cloud choice: azure (see AZURE_STT_* below).
# Each starts only its selected Compose service; see docs/development-stack.md.
WHISTLE_URL=
PARAKEET_TDT_URL=
# Optional Whisper.cpp engine runs inside Compose (model download required).
# Optional local model filename in models/whisper (defaults to ggml-small.bin).
# Larger models need more container memory; see docs/development-stack.md.
# WHISPER_MODEL=ggml-base.bin
# Set an explicit URL to use a native/remote Whisper.cpp service instead of local Whisper.
WHISPER_CPP_URL=
# Optional cloud STT (only when STT_PROVIDER=azure). Streams microphone
# audio of each utterance (max 30 s) to Azure Speech real-time recognition;
# requires your own Speech resource in an EU region and explicit consent.
# Endpoint example: https://<resource>.cognitiveservices.azure.com/
AZURE_STT_ENDPOINT=
AZURE_STT_KEY=
TTS_PROVIDER=piper
# Optional desktop-only fallback speech API base URL (for example, http://localhost:3000/api).
# Used only when the primary TTS API fails; no browser or cloud voice is selected automatically.
VITE_SODALIS_TTS_FALLBACK_API_URL=
# The default Piper HTTP engine runs inside Compose (voice download required).
# Set an explicit URL to use a native/remote Piper HTTP service instead of local Piper.
PIPER_HTTP_URL=
# Optional cloud TTS (only when TTS_PROVIDER=azure). Sends generated reply
# text to Azure; requires your own Speech or Foundry resource and explicit
# consent. URL: https://<resource>.cognitiveservices.azure.com/ (not a project
# endpoint) or a regional .../cognitiveservices/v1 endpoint.
AZURE_TTS_URL=
AZURE_TTS_KEY=
AZURE_TTS_VOICE=
# Local Pocket TTS: run pockettts.cpp with Metal on the Mac host, then start
# Sodalis' authenticated host wrapper (see docs/development-stack.md).
POCKET_TTS_URL=http://host.docker.internal:8094
POCKET_TTS_API_KEY=
POCKET_TTS_VOICE=piper-female-nl-reference
POCKET_TTS_NATIVE_URL=http://127.0.0.1:8093
POCKET_TTS_REFERENCE_WAV=
LLM_PROVIDER=openai-compatible
# Choices: openai-compatible (local/remote OpenAI-compatible), azure, mock.
# Switching changes only LLM_PROVIDER (then restart); the other provider's
# settings are ignored and there is no automatic fallback between them.
# Install host Ollama, run `ollama pull llama3.2:3b`, and keep Ollama running.
# The AI container uses this host URL; override it for a different endpoint.
# Leave URL blank with a .gguf LLM_MODEL in models/llm to use Compose llama.cpp.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
# Optional cloud LLM (only when LLM_PROVIDER=azure). Sends the conversation
# text, trusted app context, and available action list to Azure; requires your
# own Azure OpenAI or Foundry resource and explicit consent. A Data Zone EU
# deployment is recommended. URL: https://<resource>.openai.azure.com/openai/v1
# (resource endpoint, not a deployment or project URL). DEPLOYMENT is your
# deployment name (for example gpt-5). REASONING_EFFORT: minimal (default),
# low, medium or high; off for non-reasoning deployments (e.g. gpt-4.1-mini).
AZURE_LLM_URL=
AZURE_LLM_KEY=
AZURE_LLM_DEPLOYMENT=
AZURE_LLM_REASONING_EFFORT=
# Standard read-only Pi companion, embedded in the existing AI container.
# off retains turn mode (desktop actions and optional long-term memory).
# pi selects workflow mode automatically in the desktop; no actions or memory.
COMPANION_HARNESS=pi
# Neo4j origin reachable FROM the AI container, not host loopback. The AI
# container also joins the "graph" network (Docker name: the stack prefix,
# `sodalis` or `sodalis-<worktree>`); the externally managed home_simulator
# Neo4j container is expected to join it as `neo4j`. Start the stack first.
# See docs/development-stack.md#shared-graph-network. Native execution can use
# 127.0.0.1.
HOME_GRAPH_URL=bolt://neo4j:7687
HOME_GRAPH_USER=neo4j
# Required: supply the password from your Neo4j deployment before stack:up.
HOME_GRAPH_PASSWORD=
HOME_GRAPH_DATABASE=neo4j
# Must match the imported dataset; this is the current simulator snapshot.
HOME_GRAPH_SCOPE=cphs:simulation:couple-apartment
# Optional absolute SQLite file path, as seen by the Docker daemon. The launcher
# bind-mounts this one file read-only into the AI container. Docker Engine on
# Linux/WSL2 can mount any path it can read; Docker Desktop/Podman machines only
# see paths shared into their VM. Use a closed snapshot: live WAL writes and a
# file replaced after startup are not visible until the stack is restarted.
HOME_DATA_SQLITE_FILE=
# Logical graph reference, not a file path; blank uses local://simulation/timeseries.sqlite.
HOME_DATA_SQLITE_ENDPOINT=
# Long-term memory (ADR 0005). Off by default; when on, nothing is stored until
# the user records consent through PUT /api/memory/consent. Local models by
# default: an embedding model (e.g. `ollama pull qwen3-embedding:0.6b`), a small
# gate model, and an extraction model. MEMORY_EXTRACT_PROVIDER=azure sends the
# user's messages to the AZURE_LLM_* resource for extraction (consent needed);
# then leave MEMORY_EXTRACT_MODEL and MEMORY_EXTRACT_EXTRA_BODY empty to use
# AZURE_LLM_DEPLOYMENT and its reasoning effort.
MEMORY_ENABLED=false
# Development only: false skips the memory consent check entirely.
MEMORY_REQUIRE_CONSENT=true
# Development only: records the separate health consent at startup when none
# was recorded yet; a later withdrawal through the API is kept.
MEMORY_HEALTH_CONSENT=false
MEMORY_EMBED_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_EMBED_MODEL=qwen3-embedding:0.6b
MEMORY_EMBED_DIMS=512
MEMORY_GATE_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_GATE_MODEL=gemma4:e4b-mlx
# Provider-specific JSON. Ollama's OpenAI endpoint disables Qwen3 thinking with
# {"reasoning_effort":"none"}.
MEMORY_GATE_EXTRA_BODY={"reasoning_effort":"none"}
MEMORY_EXTRACT_PROVIDER=openai-compatible
MEMORY_EXTRACT_BASE_URL=http://host.docker.internal:11434/v1
MEMORY_EXTRACT_MODEL=qwen3:14b
MEMORY_EXTRACT_EXTRA_BODY={"reasoning_effort":"none"}
# Nightly System 2 consolidation (induces L5-L7 items from repeated facts).
MEMORY_CONSOLIDATION=true
HOME_PROVIDER=simulator
# First launch: admin UI at the gateway root for onboarding. Set to 0 after token setup.
HOME_ADMIN_UI=1
HOME_ASSISTANT_TOKEN=
# For HOME_PROVIDER=external-api, point at another trusted Sodalis Home API.
HOME_API_URL=
HOME_SAFE_MIN_C=16
HOME_SAFE_MAX_C=26
TZ=Europe/Amsterdam
