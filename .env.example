# Copy to .env (ignored). All provider selections live here.
SODALIS_PORT=4176
STT_PROVIDER=parakeet-tdt
# Default: original NVIDIA Parakeet TDT v3, not Parakeet Redux. Requires
# more than a 2 GB Podman VM; see docs/development-stack.md.
# Other local choices: whisper-cpp (needs models/whisper/ggml-base.bin),
# whistle (Cactus Whistle/Needle).
# Each starts only its selected Compose service; see docs/development-stack.md.
WHISTLE_URL=
PARAKEET_TDT_URL=
# Optional Whisper.cpp engine runs inside Compose (model download required).
# Optional local model filename in models/whisper (for example ggml-small.bin).
# Larger models need more container memory; see docs/development-stack.md.
# WHISPER_MODEL=ggml-small.bin
# Set an explicit URL to use a native/remote Whisper.cpp service instead of local Whisper.
WHISPER_CPP_URL=
TTS_PROVIDER=piper
# The default Piper HTTP engine runs inside Compose (voice download required).
# Set an explicit URL to use a native/remote Piper HTTP service instead of local Piper.
PIPER_HTTP_URL=
# Optional cloud TTS (only when TTS_PROVIDER=azure). Sends generated reply
# text to Azure; requires your own Speech resource and explicit consent.
AZURE_TTS_URL=
AZURE_TTS_KEY=
AZURE_TTS_VOICE=
LLM_PROVIDER=openai-compatible
# Install host Ollama, run `ollama pull llama3.2:3b`, and keep Ollama running.
# The AI container uses this host URL; override it for a different endpoint.
# Leave URL blank with a .gguf LLM_MODEL in models/llm to use Compose llama.cpp.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=llama3.2:3b
LLM_API_KEY=
HOME_PROVIDER=simulator
# First launch: admin UI at the gateway root for onboarding. Set to 0 after token setup.
HOME_ADMIN_UI=1
HOME_ASSISTANT_TOKEN=
# For HOME_PROVIDER=external-api, point at another trusted Sodalis Home API.
HOME_API_URL=
HOME_SAFE_MIN_C=16
HOME_SAFE_MAX_C=26
TZ=Europe/Amsterdam
