{
  "name": "@sodalis/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "dev:speech": "tsx watch src/speech/main.ts",
    "dev:ai": "tsx watch src/assistant/main.ts",
    "dev:home": "tsx watch src/home/main.ts",
    "start:speech": "tsx src/speech/main.ts",
    "start:pocket-tts-host": "tsx src/speech/pocketTtsHostMain.ts",
    "preprocess:voice-reference": "tsx src/speech/preprocessVoiceReferenceMain.ts",
    "start:ai": "tsx src/assistant/main.ts",
    "start:home": "tsx src/home/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@hono/node-server": "^1.19.9",
    "@sodalis/assistant": "workspace:*",
    "@sodalis/memory": "workspace:*",
    "@sodalis/speech": "workspace:*",
    "hono": "^4.13.16",
    "microsoft-cognitiveservices-speech-sdk": "1.52.0",
    "neo4j-driver": "6.3.0",
    "to-words": "^7.4.0",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "^24.10.4",
    "tsx": "^4.21.0"
  }
}
